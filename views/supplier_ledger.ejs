<div class="ui-v2">
  <div class="ui-page-header">
    <div>
      <a href="/suppliers" class="text-muted small text-decoration-none mb-1 d-inline-block">
        <i class="bi bi-arrow-left me-1"></i> Back to Suppliers
      </a>
      <h1 class="ui-title">
        <i class="bi bi-building text-warning"></i> <%= supplier.name %>
      </h1>
      <div class="text-muted small mt-1">
        <%= supplier.phone %> &bull; <%= supplier.address %> &bull; Terms: <%= supplier.terms %>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button class="btn btn-outline-secondary btn-pill fw-bold" onclick="window.print()">
        <i class="bi bi-printer me-1"></i> Print Statement
      </button>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="ui-card p-3">
        <div class="text-muted small">Total Payable Balance</div>
        <div class="fs-3 fw-bold text-danger mt-1">
          <%= formatMoney(supplier.balance) %>
        </div>
        <div class="text-muted small mt-1">Due on supplier shipments</div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="ui-card p-3">
        <div class="text-muted small">Total Material Intake (Credits)</div>
        <div class="fs-3 fw-bold text-warning mt-1"><%= formatMoney(totalCredit) %></div>
        <div class="text-muted small mt-1">GRN deliveries billed</div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="ui-card p-3">
        <div class="text-muted small">Total Payments Cleared (Debits)</div>
        <div class="fs-3 fw-bold text-success mt-1"><%= formatMoney(totalDebit) %></div>
        <div class="text-muted small mt-1">Bank / cash disbursements</div>
      </div>
    </div>
  </div>

  <div class="ui-card">
    <div class="ui-card-header">
      <h5 class="mb-0 fw-bold">Supplier Ledger History</h5>
    </div>
    <div class="ui-card-body p-0">
      <div class="table-responsive">
        <table class="ui-table mb-0">
          <thead>
            <tr>
              <th>Date</th>
              <th>Reference</th>
              <th>Description</th>
              <th class="text-end">Paid / Debit (Rs.)</th>
              <th class="text-end">Billed / Credit (Rs.)</th>
              <th class="text-end">Balance (Rs.)</th>
            </tr>
          </thead>
          <tbody>
            <% entries.forEach(e => { %>
              <tr>
                <td><%= e.date %></td>
                <td><span class="badge bg-secondary bg-opacity-25 text-body"><%= e.ref %></span></td>
                <td><strong><%= e.description %></strong></td>
                <td class="text-end text-success"><%= e.debit > 0 ? formatMoney(e.debit) : '-' %></td>
                <td class="text-end text-danger"><%= e.credit > 0 ? formatMoney(e.credit) : '-' %></td>
                <td class="text-end fw-bold"><%= formatMoney(e.balance) %></td>
              </tr>
            <% }); %>
            <% if (entries.length === 0) { %>
              <tr><td colspan="6" class="text-center text-muted p-4">No transactions recorded for this supplier.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
