<div class="ui-v2">
  <div class="ui-page-header">
    <div>
      <a href="/clients" class="text-muted small text-decoration-none mb-1 d-inline-block">
        <i class="bi bi-arrow-left me-1"></i> Back to Clients
      </a>
      <h1 class="ui-title">
        <i class="bi bi-journal-text text-warning"></i> <%= client.name %>
      </h1>
      <div class="text-muted small mt-1">
        <%= client.phone %> &bull; <%= client.address %> &bull; <span class="badge bg-secondary bg-opacity-25 text-body"><%= client.type %></span>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button class="btn btn-success btn-pill fw-bold" data-bs-toggle="modal" data-bs-target="#paymentModal">
        <i class="bi bi-cash-stack me-1"></i> Receive Payment
      </button>
      <button class="btn btn-outline-secondary btn-pill fw-bold" onclick="window.print()">
        <i class="bi bi-printer me-1"></i> Print Statement
      </button>
    </div>
  </div>

  <!-- Financial Cards -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="ui-card p-3">
        <div class="text-muted small">Current Outstanding Balance</div>
        <div class="fs-3 fw-bold <%= client.balance > 0 ? 'text-danger' : 'text-success' %> mt-1">
          <%= formatMoney(client.balance) %>
        </div>
        <div class="text-muted small mt-1">Net pending amount</div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="ui-card p-3">
        <div class="text-muted small">Total Debits (Billed)</div>
        <div class="fs-3 fw-bold text-warning mt-1"><%= formatMoney(totalDebit) %></div>
        <div class="text-muted small mt-1">Total materials sold & invoiced</div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="ui-card p-3">
        <div class="text-muted small">Total Credits (Paid)</div>
        <div class="fs-3 fw-bold text-success mt-1"><%= formatMoney(totalCredit) %></div>
        <div class="text-muted small mt-1">All payments collected</div>
      </div>
    </div>
  </div>

  <!-- Ledger Transactions Table -->
  <div class="ui-card">
    <div class="ui-card-header">
      <h5 class="mb-0 fw-bold">Statement of Account</h5>
    </div>
    <div class="ui-card-body p-0">
      <div class="table-responsive">
        <table class="ui-table mb-0">
          <thead>
            <tr>
              <th>Date</th>
              <th>Reference</th>
              <th>Description</th>
              <th class="text-end">Debit (Rs.)</th>
              <th class="text-end">Credit (Rs.)</th>
              <th class="text-end">Running Balance (Rs.)</th>
            </tr>
          </thead>
          <tbody>
            <% entries.forEach(e => { %>
              <tr>
                <td><%= e.date %></td>
                <td><span class="badge bg-secondary bg-opacity-25 text-body"><%= e.ref %></span></td>
                <td><strong><%= e.description %></strong></td>
                <td class="text-end text-danger"><%= e.debit > 0 ? formatMoney(e.debit) : '-' %></td>
                <td class="text-end text-success"><%= e.credit > 0 ? formatMoney(e.credit) : '-' %></td>
                <td class="text-end fw-bold"><%= formatMoney(e.balance) %></td>
              </tr>
            <% }); %>
            <% if (entries.length === 0) { %>
              <tr><td colspan="6" class="text-center text-muted p-4">No ledger transactions posted yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Receive Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content" style="background: var(--ui-surface); border: 1px solid var(--ui-border); color: var(--ui-text);">
      <form action="/api/client_ledger/payment" method="POST">
        <input type="hidden" name="clientId" value="<%= client.id %>">
        <div class="modal-header border-bottom border-secondary border-opacity-25">
          <h5 class="modal-title fw-bold text-success">
            <i class="bi bi-cash-coin me-1"></i> Receive Client Payment
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small text-muted">Amount Received (Rs.)</label>
            <input type="number" name="amount" class="form-control form-control-lg text-success fw-bold" placeholder="0" required max="<%= client.balance > 0 ? client.balance : 99999999 %>">
            <div class="small text-muted mt-1">Outstanding: <%= formatMoney(client.balance) %></div>
          </div>
          <div class="mb-3">
            <label class="form-label small text-muted">Payment Channel</label>
            <select name="paymentMethod" class="form-select">
              <option value="Cash">Physical Cash Drawer</option>
              <option value="Bank (Meezan)">Meezan Bank</option>
              <option value="Bank (HBL)">HBL Corporate A/c</option>
              <option value="Cheque">Crossed Cheque</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label small text-muted">Reference / Cheque #</label>
            <input type="text" name="ref" class="form-control" placeholder="e.g. TR-8849 / CHQ-1002">
          </div>
          <div class="mb-3">
            <label class="form-label small text-muted">Notes / Memo</label>
            <input type="text" name="description" class="form-control" placeholder="e.g. Partial recovery for project invoice">
          </div>
        </div>
        <div class="modal-footer border-top border-secondary border-opacity-25">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success fw-bold">Post Payment Receipt</button>
        </div>
      </form>
    </div>
  </div>
</div>
