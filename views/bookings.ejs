<div class="ui-v2">
  <div class="ui-page-header">
    <div>
      <h1 class="ui-title">
        <i class="bi bi-bookmark-plus text-warning"></i> Advance Material Bookings
      </h1>
      <div class="text-muted small mt-1">Contractor advance rate locks, payment terms, and scheduled deliveries</div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button class="btn btn-warning btn-pill fw-bold" data-bs-toggle="modal" data-bs-target="#newBookingModal">
        <i class="bi bi-bookmark-check me-1"></i> New Booking
      </button>
    </div>
  </div>

  <div class="ui-card">
    <div class="ui-card-header">
      <h5 class="mb-0 fw-bold">Active Bookings Pipeline</h5>
    </div>
    <div class="ui-card-body p-0">
      <div class="table-responsive">
        <table class="ui-table mb-0">
          <thead>
            <tr>
              <th>Booking ID</th>
              <th>Date</th>
              <th>Client</th>
              <th>Material</th>
              <th class="text-center">Total Qty</th>
              <th class="text-center">Dispatched</th>
              <th class="text-end">Locked Rate</th>
              <th class="text-end">Total Amount</th>
              <th class="text-end">Advance Paid</th>
              <th class="text-end">Remaining</th>
              <th class="text-center">Status</th>
            </tr>
          </thead>
          <tbody>
            <% bookings.forEach(b => { %>
              <tr>
                <td><strong class="text-warning"><%= b.id %></strong></td>
                <td><%= b.date %></td>
                <td><strong><%= b.clientName %></strong></td>
                <td><%= b.materialName %></td>
                <td class="text-center fw-bold"><%= b.quantity %> <small class="text-muted"><%= b.unit %></small></td>
                <td class="text-center text-info fw-bold"><%= b.dispatchedQuantity %> <%= b.unit %></td>
                <td class="text-end text-muted"><%= formatMoney(b.rate) %></td>
                <td class="text-end fw-bold"><%= formatMoney(b.totalAmount) %></td>
                <td class="text-end text-success"><%= formatMoney(b.advancePaid) %></td>
                <td class="text-end text-danger fw-bold"><%= formatMoney(b.remainingAmount) %></td>
                <td class="text-center">
                  <span class="badge bg-warning bg-opacity-25 text-warning"><%= b.status %></span>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- New Booking Modal -->
<div class="modal fade" id="newBookingModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content" style="background: var(--ui-surface); border: 1px solid var(--ui-border); color: var(--ui-text);">
      <form action="/api/bookings" method="POST">
        <div class="modal-header border-bottom border-secondary border-opacity-25">
          <h5 class="modal-title fw-bold text-warning">
            <i class="bi bi-bookmark-plus-fill me-1"></i> Lock Advance Booking
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small text-muted">Client</label>
            <select name="clientId" class="form-select" required>
              <% clients.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.name %></option>
              <% }); %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label small text-muted">Material / Brand</label>
            <select name="materialId" class="form-select" required>
              <% materials.forEach(m => { %>
                <option value="<%= m.id %>"><%= m.name %> (<%= m.unit %>)</option>
              <% }); %>
            </select>
          </div>
          <div class="row g-2 mb-3">
            <div class="col">
              <label class="form-label small text-muted">Quantity</label>
              <input type="number" name="quantity" class="form-control" placeholder="1000" required min="1">
            </div>
            <div class="col">
              <label class="form-label small text-muted">Locked Rate (Rs.)</label>
              <input type="number" name="rate" class="form-control" placeholder="1240" required>
            </div>
          </div>
          <div class="row g-2 mb-3">
            <div class="col">
              <label class="form-label small text-muted">Advance Paid (Rs.)</label>
              <input type="number" name="advancePaid" class="form-control text-success fw-bold" placeholder="0" value="0">
            </div>
            <div class="col">
              <label class="form-label small text-muted">Expected Delivery Date</label>
              <input type="date" name="expectedDate" class="form-control">
            </div>
          </div>
        </div>
        <div class="modal-footer border-top border-secondary border-opacity-25">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning fw-bold">Register Booking</button>
        </div>
      </form>
    </div>
  </div>
</div>
