<div class="ui-v2">
  <div class="ui-page-header">
    <div>
      <h1 class="ui-title">
        <i class="bi bi-building text-warning"></i> Material Suppliers & Vendors
      </h1>
      <div class="text-muted small mt-1">Cement manufacturers, mills, logistics partners, and payables</div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button class="btn btn-warning btn-pill fw-bold" data-bs-toggle="modal" data-bs-target="#addSupplierModal">
        <i class="bi bi-building-add me-1"></i> Add Supplier
      </button>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="ui-card p-3">
        <div class="text-muted small">Total Registered Suppliers</div>
        <div class="fs-3 fw-bold text-info mt-1"><%= suppliers.length %></div>
        <div class="text-muted small mt-1">Active vendor network</div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="ui-card p-3">
        <div class="text-muted small">Total Outstanding Payables</div>
        <div class="fs-3 fw-bold text-danger mt-1"><%= formatMoney(totalPayables) %></div>
        <div class="text-muted small mt-1">Due on supplier shipments</div>
      </div>
    </div>
  </div>

  <div class="ui-card">
    <div class="ui-card-header">
      <h5 class="mb-0 fw-bold">Supplier Directory</h5>
    </div>
    <div class="ui-card-body p-0">
      <div class="table-responsive">
        <table class="ui-table mb-0">
          <thead>
            <tr>
              <th>Supplier / Mill</th>
              <th>Contact</th>
              <th>Location</th>
              <th>Credit Terms</th>
              <th class="text-end">Balance Payable</th>
              <th class="text-center">Action</th>
            </tr>
          </thead>
          <tbody>
            <% suppliers.forEach(s => { %>
              <tr>
                <td><strong><%= s.name %></strong></td>
                <td><%= s.phone %></td>
                <td class="text-muted small"><%= s.address %></td>
                <td><span class="badge bg-secondary bg-opacity-25 text-body"><%= s.terms %></span></td>
                <td class="text-end fw-bold text-danger"><%= formatMoney(s.balance) %></td>
                <td class="text-center">
                  <a href="/supplier_ledger/<%= s.id %>" class="btn btn-sm btn-outline-warning fw-bold">
                    <i class="bi bi-journal-text me-1"></i> Ledger
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Add Supplier Modal -->
<div class="modal fade" id="addSupplierModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content" style="background: var(--ui-surface); border: 1px solid var(--ui-border); color: var(--ui-text);">
      <form action="/api/suppliers" method="POST">
        <div class="modal-header border-bottom border-secondary border-opacity-25">
          <h5 class="modal-title fw-bold text-warning">
            <i class="bi bi-building-add me-1"></i> Add Supplier / Vendor
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small text-muted">Supplier / Mill Name</label>
            <input type="text" name="name" class="form-control" placeholder="e.g. Cherat Cement Co." required>
          </div>
          <div class="row g-2 mb-3">
            <div class="col">
              <label class="form-label small text-muted">Phone Number</label>
              <input type="text" name="phone" class="form-control" placeholder="051-0000000">
            </div>
            <div class="col">
              <label class="form-label small text-muted">Payment Terms</label>
              <input type="text" name="terms" class="form-control" placeholder="Net 30">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label small text-muted">Plant / Office Address</label>
            <input type="text" name="address" class="form-control" placeholder="Address">
          </div>
          <div class="mb-3">
            <label class="form-label small text-muted">Opening Payable Balance (Rs.)</label>
            <input type="number" name="openingBalance" class="form-control" placeholder="0" value="0">
          </div>
        </div>
        <div class="modal-footer border-top border-secondary border-opacity-25">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning fw-bold">Save Supplier</button>
        </div>
      </form>
    </div>
  </div>
</div>
