<div class="ui-v2">
  <div class="ui-page-header">
    <div>
      <h1 class="ui-title">
        <i class="bi bi-person-badge text-warning"></i> Delivery Staff & Fleet Vehicles
      </h1>
      <div class="text-muted small mt-1">Manage truck drivers, vehicle registration numbers, and delivery capacity</div>
    </div>
    <button class="btn btn-warning btn-pill fw-bold" data-bs-toggle="modal" data-bs-target="#addDriverModal">
      <i class="bi bi-plus-circle me-1"></i> Add Driver / Vehicle
    </button>
  </div>

  <div class="ui-card">
    <div class="ui-card-header">
      <h5 class="mb-0 fw-bold">Active Fleet & Drivers</h5>
    </div>
    <div class="ui-card-body p-0">
      <div class="table-responsive">
        <table class="ui-table mb-0">
          <thead>
            <tr>
              <th>ID</th>
              <th>Driver Name</th>
              <th>Assigned Vehicle</th>
              <th>Phone Number</th>
              <th class="text-center">Total Trips</th>
              <th class="text-center">Current Status</th>
            </tr>
          </thead>
          <tbody>
            <% drivers.forEach(d => { %>
              <tr>
                <td>#<%= d.id %></td>
                <td><strong><%= d.name %></strong></td>
                <td><span class="badge bg-secondary bg-opacity-25 text-body"><%= d.vehicle %></span></td>
                <td><%= d.phone %></td>
                <td class="text-center fw-bold text-info"><%= d.deliveriesCount %> trips</td>
                <td class="text-center">
                  <span class="badge <%= d.status === 'Available' ? 'bg-success text-success' : 'bg-warning text-warning' %> bg-opacity-25">
                    <%= d.status %>
                  </span>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Add Driver Modal -->
<div class="modal fade" id="addDriverModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content" style="background: var(--ui-surface); border: 1px solid var(--ui-border); color: var(--ui-text);">
      <form action="/api/delivery_persons" method="POST">
        <div class="modal-header border-bottom border-secondary border-opacity-25">
          <h5 class="modal-title fw-bold text-warning">
            <i class="bi bi-truck me-1"></i> Register Driver & Vehicle
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small text-muted">Driver Full Name</label>
            <input type="text" name="name" class="form-control" placeholder="e.g. Tariq Mehmood" required>
          </div>
          <div class="mb-3">
            <label class="form-label small text-muted">Phone Number</label>
            <input type="text" name="phone" class="form-control" placeholder="0300-0000000">
          </div>
          <div class="mb-3">
            <label class="form-label small text-muted">Vehicle Details / Plate No</label>
            <input type="text" name="vehicle" class="form-control" placeholder="e.g. Hino Truck LEA-9900">
          </div>
        </div>
        <div class="modal-footer border-top border-secondary border-opacity-25">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning fw-bold">Register Driver</button>
        </div>
      </form>
    </div>
  </div>
</div>
