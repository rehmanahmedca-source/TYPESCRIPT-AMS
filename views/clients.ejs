<div class="ui-v2">
  <div class="ui-page-header">
    <div>
      <h1 class="ui-title">
        <i class="bi bi-people text-warning"></i> Registered Clients & Ledgers
      </h1>
      <div class="text-muted small mt-1">Client accounts, receivables, and balance tracking</div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button class="btn btn-warning btn-pill fw-bold" data-bs-toggle="modal" data-bs-target="#addClientModal">
        <i class="bi bi-person-plus me-1"></i> Add New Client
      </button>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="ui-card p-3">
        <div class="text-muted small">Total Registered Clients</div>
        <div class="fs-3 fw-bold text-info mt-1"><%= clients.length %></div>
        <div class="text-muted small mt-1">Active customer directory</div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="ui-card p-3">
        <div class="text-muted small">Total Outstanding Receivables</div>
        <div class="fs-3 fw-bold text-danger mt-1"><%= formatMoney(totalReceivables) %></div>
        <div class="text-muted small mt-1">Due from credit sales</div>
      </div>
    </div>
  </div>

  <div class="ui-card">
    <div class="ui-card-header d-flex align-items-center justify-content-between">
      <h5 class="mb-0 fw-bold">Customer Directory</h5>
      <input type="text" id="clientFilter" class="form-control form-control-sm w-auto" placeholder="Search clients...">
    </div>
    <div class="ui-card-body p-0">
      <div class="table-responsive">
        <table class="ui-table mb-0" id="clientsTable">
          <thead>
            <tr>
              <th>Client Name</th>
              <th>Contact Phone</th>
              <th>Address / Site</th>
              <th>Customer Type</th>
              <th class="text-end">Current Balance</th>
              <th class="text-center">Action</th>
            </tr>
          </thead>
          <tbody>
            <% clients.forEach(c => { %>
              <tr>
                <td><strong><%= c.name %></strong></td>
                <td><%= c.phone %></td>
                <td class="text-muted small"><%= c.address %></td>
                <td><span class="badge bg-secondary bg-opacity-25 text-body"><%= c.type %></span></td>
                <td class="text-end fw-bold <%= c.balance > 0 ? 'text-danger' : 'text-success' %>">
                  <%= formatMoney(c.balance) %>
                </td>
                <td class="text-center">
                  <a href="/client_ledger/<%= c.id %>" class="btn btn-sm btn-outline-warning fw-bold">
                    <i class="bi bi-journal-text me-1"></i> Ledger
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Add Client Modal -->
<div class="modal fade" id="addClientModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content" style="background: var(--ui-surface); border: 1px solid var(--ui-border); color: var(--ui-text);">
      <form action="/api/clients" method="POST">
        <div class="modal-header border-bottom border-secondary border-opacity-25">
          <h5 class="modal-title fw-bold text-warning">
            <i class="bi bi-person-plus-fill me-1"></i> Add Client Account
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small text-muted">Client / Company Name</label>
            <input type="text" name="name" class="form-control" placeholder="e.g. Al-Madina Construction" required>
          </div>
          <div class="row g-2 mb-3">
            <div class="col">
              <label class="form-label small text-muted">Phone Number</label>
              <input type="text" name="phone" class="form-control" placeholder="0300-0000000">
            </div>
            <div class="col">
              <label class="form-label small text-muted">Client Type</label>
              <select name="type" class="form-select">
                <option value="Contractor">Contractor</option>
                <option value="Builder">Builder</option>
                <option value="Commercial">Commercial Project</option>
                <option value="Retail">Retail / Individual</option>
              </select>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label small text-muted">Site / Billing Address</label>
            <input type="text" name="address" class="form-control" placeholder="Plot / Site location">
          </div>
          <div class="mb-3">
            <label class="form-label small text-muted">Opening Balance (Rs.)</label>
            <input type="number" name="openingBalance" class="form-control" placeholder="0" value="0">
          </div>
        </div>
        <div class="modal-footer border-top border-secondary border-opacity-25">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning fw-bold">Create Client</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const clientFilter = document.getElementById('clientFilter');
  if (clientFilter) {
    clientFilter.addEventListener('input', function() {
      const q = this.value.toLowerCase();
      document.querySelectorAll('#clientsTable tbody tr').forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
      });
    });
  }
</script>
